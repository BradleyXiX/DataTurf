# Vercel Deployment Configuration
# ------------------------------------------------------------------------------
# Option 1 (Recommended): Server-side Next.js rewrite proxy
# Rewrites all requests from /api/* to the Render backend service, avoiding CORS issues.
BACKEND_URL=https://dataturf-backend.onrender.com

# Option 2: Direct client-side calls
# If set, client-side fetches will directly target this base URL.
NEXT_PUBLIC_API_URL=https://dataturf-backend.onrender.com

# For local development:
# BACKEND_URL=http://localhost:5000

