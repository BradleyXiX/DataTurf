# Supabase Connection URL (Recommended for production on Render)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Alternatively, discrete credentials (for local dev)
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=dataturf
# DB_PASSWORD=password
# DB_PORT=5434

PORT=10000

